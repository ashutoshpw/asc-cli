{
  "name": "asc",
  "version": "0.1.0",
  "description": "App Store Connect CLI - A fast, lightweight CLI for App Store Connect",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "main": "src/index.ts",
  "bin": {
    "asc": "src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun run build.ts",
    "build:all": "bun run build.ts --all",
    "test": "bun test --isolate",
    "test:coverage": "bun test --isolate --coverage --coverage-reporter=lcov",
    "test:staged": "bun run scripts/precommit.ts",
    "validate:api": "bun run scripts/validate-api-routes.ts",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "bunx @biomejs/biome check src scripts build.ts",
    "format": "bunx @biomejs/biome format --write src scripts build.ts",
    "check": "bun run lint && bun run typecheck && bun run test:coverage && bun run build",
    "link": "bun link",
    "prepare": "husky"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "fflate": "0.8.3",
    "jose": "^6.2.10",
    "plist": "5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "^1.4.0",
    "husky": "9.1.7",
    "typescript": "7.0.2"
  },
  "keywords": [
    "app-store-connect",
    "apple",
    "cli",
    "ios",
    "macos",
    "testflight"
  ],
  "author": "Ashutosh Kumar <ashutosh@w3dev.in>",
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.0"
  }
}
